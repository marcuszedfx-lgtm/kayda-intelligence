// Kayda Intelligence V1.2 canonical relational model.
// Not connected in V1.2 yet; this is the migration contract for PostgreSQL.

generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

model Business { id String @id @default(cuid()); name String; category String; status String; description String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; deals Deal[]; contacts Contact[]; projects Project[] }
model Contact { id String @id @default(cuid()); name String; organization String; role String; email String?; phone String?; lastContact String; nextAction String; businessId String?; business Business? @relation(fields:[businessId], references:[id]); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Deal { id String @id @default(cuid()); name String; businessId String?; business Business? @relation(fields:[businessId], references:[id]); counterparty String; value String; stage String; probability Int; health String; nextAction String; risk String; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; tasks Task[] }
model Project { id String @id @default(cuid()); name String; businessId String?; business Business? @relation(fields:[businessId], references:[id]); status String; progress Int; health String; blocker String; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; tasks Task[] }
model Task { id String @id @default(cuid()); title String; status String; priority String; due String; dealId String?; deal Deal? @relation(fields:[dealId], references:[id]); projectId String?; project Project? @relation(fields:[projectId], references:[id]); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Activity { id String @id @default(cuid()); title String; detail String; time String; type String; createdAt DateTime @default(now()) }
model Document { id String @id @default(cuid()); name String; mimeType String?; storageKey String?; extractedText String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Communication { id String @id @default(cuid()); channel String; subject String?; body String; direction String; contactId String?; createdAt DateTime @default(now()) }
model Risk { id String @id @default(cuid()); title String; description String; severity String; status String; dealId String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Commitment { id String @id @default(cuid()); title String; owner String; dueAt DateTime?; status String; source String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
