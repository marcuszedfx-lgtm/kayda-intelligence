# Kayda Intelligence environment

# Isolated Kayda PostgreSQL. Use host port 5433.
# Never point this at port 5432 (trading platform).
# Example only — do not put a real password here.
# postgresql://kayda:YOUR_PASSWORD@localhost:5433/kayda_intelligence?schema=public
DATABASE_URL=

# =========================================================
# OPERATOR LOGIN
# =========================================================

# The single-operator token that guards every read and write
# route. Generate a fresh one with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Minimum 32 characters. A shorter value is rejected and
# login stays disabled. The token is compared on the server in
# constant time and is never returned to the browser, never
# stored in localStorage or sessionStorage, and never placed
# in a cookie. Rotating it invalidates every existing session.
KAYDA_OPERATOR_TOKEN=

# Optional: session lifetime in hours. Defaults to 12.
# KAYDA_SESSION_TTL_HOURS=

# Optional: extra host names the proxy will answer to, beyond
# localhost / 127.0.0.1 / ::1. Comma separated.
# KAYDA_ALLOWED_HOSTS=

# Optional: extra database hosts the port guard will accept,
# beyond localhost / 127.0.0.1 / ::1. Comma separated.
# KAYDA_ALLOWED_DB_HOSTS=

# =========================================================
# DEPLOYMENT / TRUST BOUNDARY
# =========================================================

# Leave unset (the default) unless Kayda runs BEHIND a reverse
# proxy that you control and that sets the two forwarded headers.
#
#   KAYDA_TRUSTED_PROXY=1
#
# Off: X-Forwarded-Proto and X-Forwarded-For are ignored
# completely — the connection itself decides whether the request
# was HTTPS, and every caller shares one login-throttle bucket.
# This is correct for the normal deployment, where Kayda answers
# directly on the loopback interface and any forwarded header was
# typed by the client.
#
# On: X-Forwarded-Proto is honoured (only "http" or "https",
# read right-to-left) when deciding whether the session cookie
# gets the Secure attribute, and the rightmost X-Forwarded-For
# value becomes the login-throttle bucket key. Never enable this
# without a proxy in front: a client could otherwise choose both.
# KAYDA_TRUSTED_PROXY=

# Optional: pin the port this application is meant to answer on,
# e.g. 3102. When set, a state-changing request whose Origin
# names any other port is refused even if it matches the request.
# Unset by default, which validates origins against the port the
# request actually arrived on.
# KAYDA_APP_PORT=

